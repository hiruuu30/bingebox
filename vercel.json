{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node ./scripts/build.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/movie-proxy.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/movie-proxy",
      "dest": "/api/movie-proxy"
    },
    {
      "src": "/(.*)",
      "dest": "/api/movie-proxy?path=$1"
    }
  ]
}
